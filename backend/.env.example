# Copy to .env and fill in your values

DATABASE_URL=postgresql://localhost/taskmgmt

# SMTP settings (Gmail example — use an App Password, not your account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your_app_password_here

# Fallback email when a task has no reminder_email set
DEFAULT_REMINDER_EMAIL=you@gmail.com
